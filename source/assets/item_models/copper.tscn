code = "shader_type spatial; varying vec3 p; uniform vec3 mineral:source_color;uniform float metal=0.0;uniform bool plain=false;void vertex(){p=VERTEX;}void fragment(){float grit=sin(p.x*47.0+p.y*29.0)*sin(p.z*53.0-p.y*19.0);float v=abs(sin(p.x*9.0+p.y*7.0+sin(p.z*8.0)+sin(p.y*14.0)*0.4));float vein=1.0-smoothstep(0.08,0.2,v);if(plain){vein=0.0;}ALBEDO=mix(vec3(0.23,0.24,0.25)*(0.85+0.16*grit),mineral,vein);ROUGHNESS=mix(0.92,0.35,vein);METALLIC=vein*metal;}"

