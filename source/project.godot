; ตำนานเอลโดเรีย - เวอร์ชัน Godot (ขั้นที่ 1: เมืองเอลโดเรีย)
config_version=5

[application]

config/name="Eldoria Godot"
run/main_scene="res://startup.tscn"
config/version="0.11-craft"
run/max_fps.mobile=30
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/dpi/allow_hidpi=false
window/handheld/orientation=0

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=512
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)

[gui]

theme/custom_font="res://fonts/Kanit-Regular.ttf"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/eldoria.log"
file_logging/max_log_files=3
