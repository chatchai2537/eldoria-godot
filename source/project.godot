; ตำนานเอลโดเรีย - เวอร์ชัน Godot (ขั้นที่ 1: เมืองเอลโดเรีย)
config_version=5

[application]

config/name="Eldoria Godot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/dpi/allow_hidpi=false
window/handheld/orientation=0

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)

[gui]

theme/custom_font="res://fonts/Kanit-Regular.ttf"
